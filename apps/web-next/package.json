{
  "name": "web-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/privacy-scan.mjs source && next build && node scripts/privacy-scan.mjs build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/privacy-scan.mjs source && tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js",
    "eval:webmcp": "tsc -p tsconfig.tests.json && node .test-dist/evals/webmcp-eval-runner.js",
    "preflight:deployment": "npm test && npm run eval:webmcp && npm run build && node scripts/deployment-preflight.mjs --strict",
    "preflight:deployment:report": "node scripts/deployment-preflight.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "14.2.31",
    "papaparse": "5.4.1",
    "plotly.js": "2.32.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-plotly.js": "2.6.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.1.9",
    "@types/react-plotly.js": "^2.6.3",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.31",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.7",
    "typescript": "5.4.5"
  }
}
